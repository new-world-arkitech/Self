# ==============================================================================
# SELF. // Production Environment Template (.env.example)
# Copy this file to '.env' and populate with your local values.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & RUNTIME
# ------------------------------------------------------------------------------
APP_NAME=Self
APP_ENV=development               # development | staging | production
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=true
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# Cryptographic salt / token secret for local session signing
SECRET_KEY=change_me_to_a_secure_random_64_char_hex_key

# ------------------------------------------------------------------------------
# 2. DOMAIN FOLDERS & KNOWLEDGE INGESTION PATHS
# (Relative to project root or absolute paths)
# ------------------------------------------------------------------------------
DOMAIN_KNOWLEDGE_PATH=./src/Self.knowledge
DOMAIN_CAREER_PATH=./src/Self.career
DOMAIN_CREDIT_PATH=./src/Self.credit
DOMAIN_TEMPLE_PATH=./src/Self.temple
DOMAIN_LEGAL_PATH=./src/Self.legal

# Engine storage files
STATE_MATRIX_FILE=./src/engine/state_matrix.json
JOURNAL_LEDGER_FILE=./src/engine/journal_ledger.json
ACCEPTANCE_TEST_REPORT=./src/engine/client_acceptance_test_report.html

# ------------------------------------------------------------------------------
# 3. 3D AVATAR & RENDER PIPELINE
# ------------------------------------------------------------------------------
# Fallback humanoid rig path (.glb / .gltf)
DEFAULT_AVATAR_MODEL=/models/self_avatar.glb
AVATAR_QUALITY=high               # low | medium | high | ultra
ENABLE_SKINNING_SHADERS=true
ENABLE_HARDWARE_FRESNEL=true
TARGET_FRAME_RATE=60

# ------------------------------------------------------------------------------
# 4. COGNITIVE VERIFICATION & XP PARAMETERS
# ------------------------------------------------------------------------------
# Minimum quiz pass grade to verify a document milestone (0.00 to 1.00)
QUIZ_PASS_THRESHOLD=0.80

# Base XP allocation weights
XP_PER_PAGE_KNOWLEDGE=25
XP_PER_TASK_KNOWLEDGE=40
XP_PER_PAGE_CAREER=15
XP_PER_TASK_CAREER=50
XP_PER_PAGE_CREDIT=10
XP_PER_TASK_CREDIT=75
XP_PER_PAGE_TEMPLE=20
XP_PER_TASK_TEMPLE=60

# Spaced Repetition Scheduling (Review intervals in days)
SPACED_REPETITION_INTERVALS=1,3,7,14,30

# ------------------------------------------------------------------------------
# 5. HIGH-ACHIEVING PSYCHOMETRICS & GRIT ENGINE
# ------------------------------------------------------------------------------
# Penalty multiplier applied when an accepted mission is abandoned without valid pivot
ABANDONMENT_PENALTY_WEIGHT=1.5

# Daily streak decay factor if physical/cognitive check-in is missed (0.00 - 1.00)
DAILY_STREAK_DECAY_RATE=0.05

# Minimum days required to lock in a new vitality tier
TIER_PROBATION_DAYS=7

# ------------------------------------------------------------------------------
# 6. LOCAL AI / LLM INFERENCE (Optional local verification)
# ------------------------------------------------------------------------------
LLM_PROVIDER=offline              # offline | local_gemma | openai | anthropic
LLM_MODEL=gemma-4
LOCAL_LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=

# ------------------------------------------------------------------------------
# 7. PERSONAL VAULT & SOVEREIGN CREDENTIALS (LOCAL-ONLY / ENCRYPTED)
# (Warning: Keep strictly in local .env - Never share or push)
# ------------------------------------------------------------------------------
DATE_OF_BIRTH=YYYY-MM-DD
SOCIAL_SECURITY=XXX-XX-XXXX
BRAVE_WALLET=twelve word mnemonic recovery phrase goes here
